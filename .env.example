# Optional. Copy to .env.local in the repository root and uncomment only what you need.
# Values below show the defaults. No file is required to play.
# Public game settings are bundled at build time: restart dev / rebuild production after edits.

# NEXT_PUBLIC_GAME_PLAYER_NAME=Player
# NEXT_PUBLIC_GAME_VOLUME=0.7
# NEXT_PUBLIC_GAME_AMBIENCE=true
# NEXT_PUBLIC_GAME_QUALITY=auto
# NEXT_PUBLIC_GAME_TABLE_SURFACE=oak
# NEXT_PUBLIC_GAME_FOLLOW=false
# NEXT_PUBLIC_GAME_REPLAY=true
# NEXT_PUBLIC_GAME_SLOWMO=true
# NEXT_PUBLIC_GAME_FPS=false
# NEXT_PUBLIC_GAME_AIM_GUIDE=true
# NEXT_PUBLIC_GAME_FRICTION=0.98
# NEXT_PUBLIC_GAME_REALISM=true
# NEXT_PUBLIC_GAME_DEFAULT_PEN=matador_hs
# NEXT_PUBLIC_GAME_DIFFICULTY=advanced
# NEXT_PUBLIC_GAME_VS_GOAL=3
# NEXT_PUBLIC_GAME_TRAINING_GOAL=99
# NEXT_PUBLIC_GAME_AI_GOAL=5
# NEXT_PUBLIC_GAME_CAMERA_ZOOM=1

# Advanced: partial JSON matching the sections combined in src/config/config.ts. Omitted values keep defaults.
# Individual variables above override the same fields in this JSON.
# NEXT_PUBLIC_GAME_CONFIG='{"camera":{"presets":{"overview":{"azimuth":30,"elevation":65}}},"input":{"penSafetyTouch":48},"preferences":{"ai":{"a":"astar","b":"mcts","speed":2}},"graphics":{"exposure":1}}'

# Precedence: code defaults < JSON < individual variables < saved player preferences.
# Clear this site's pfa.settings / pfa.preferences storage to try fresh defaults.
# These variables are public browser configuration. Never put secrets in them.
